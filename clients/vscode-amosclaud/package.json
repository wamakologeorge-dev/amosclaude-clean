{
  "name": "amosclaud-autonomous",
  "displayName": "Amosclaud Autonomous",
  "description": "Repository-aware Amosclaud chat, planning, governed execution, and MCP tools inside VS Code.",
  "version": "0.2.0",
  "publisher": "amosclaud",
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://www.amosclaud.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/wamakologeorge-dev/amosclaude-clean.git"
  },
  "bugs": {
    "url": "https://github.com/wamakologeorge-dev/amosclaude-clean/issues"
  },
  "engines": {
    "vscode": "^1.99.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "capabilities": {
    "virtualWorkspaces": {
      "supported": true
    },
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Planning and read-only status are available. Repository execution remains governed by Amosclaud authorization."
    }
  },
  "activationEvents": [
    "onView:amosclaud.chatView",
    "onCommand:amosclaud.configureToken",
    "onCommand:amosclaud.planTask",
    "onCommand:amosclaud.runTask",
    "onChatParticipant:amosclaud-autonomous.amosclaud"
  ],
  "main": "./web-extension.js",
  "browser": "./web-extension.js",
  "contributes": {
    "commands": [
      {
        "command": "amosclaud.configureToken",
        "title": "Amosclaud: Configure Autonomous Token"
      },
      {
        "command": "amosclaud.planTask",
        "title": "Amosclaud: Plan Current Task"
      },
      {
        "command": "amosclaud.runTask",
        "title": "Amosclaud: Run Current Task"
      }
    ],
    "chatParticipants": [
      {
        "id": "amosclaud-autonomous.amosclaud",
        "name": "amosclaud",
        "fullName": "Amosclaud Autonomous",
        "description": "Plan, build, fix, test, deploy, and verify through Amosclaud",
        "isSticky": true,
        "commands": [
          {
            "name": "plan",
            "description": "Prepare a governed implementation plan"
          },
          {
            "name": "run",
            "description": "Start authorized Autonomous work"
          },
          {
            "name": "fix",
            "description": "Run a verified repair through Amosclaud Fixer"
          },
          {
            "name": "build",
            "description": "Build and test through Amosclaud Action"
          },
          {
            "name": "deploy",
            "description": "Prepare governed deployment work"
          },
          {
            "name": "security",
            "description": "Plan an Amosclaud Security review"
          },
          {
            "name": "agents",
            "description": "List internal Amosclaud capabilities"
          },
          {
            "name": "status",
            "description": "Check Amosclaud health and readiness"
          }
        ]
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "amosclaud",
          "title": "Amosclaud",
          "icon": "media/amosclaud.svg"
        }
      ]
    },
    "views": {
      "amosclaud": [
        {
          "type": "webview",
          "id": "amosclaud.chatView",
          "name": "Autonomous Chat"
        }
      ]
    },
    "configuration": {
      "title": "Amosclaud",
      "properties": {
        "amosclaud.baseUrl": {
          "type": "string",
          "default": "https://www.amosclaud.com",
          "description": "HTTPS Amosclaud platform URL. Localhost HTTP is allowed for development."
        },
        "amosclaud.repository": {
          "type": "string",
          "default": "",
          "description": "Optional owner/repository name included in bounded editor context."
        },
        "amosclaud.branch": {
          "type": "string",
          "default": "main",
          "description": "Current repository branch when Git metadata is unavailable."
        }
      }
    }
  },
  "scripts": {
    "check": "node --check web-extension.js && node --check src/client.js",
    "test": "node --test"
  },
  "devDependencies": {}
}
