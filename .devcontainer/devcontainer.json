{
  "name": "Amosclaud Platform Workspace",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "runServices": ["postgres", "redis"],
  "workspaceFolder": "/workspaces/amosclaude-clean",
  "shutdownAction": "stopCompose",
  "waitFor": "postCreateCommand",
  "privileged": true,
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:4": {}
  },
  "forwardPorts": [8000, 8001, 8091, 9090, 5432, 6379],
  "portsAttributes": {
    "8000": {
      "label": "Amosclaud Platform API",
      "onAutoForward": "openPreview"
    },
    "8001": {
      "label": "Amosclaud Credential Authority",
      "onAutoForward": "silent"
    },
    "8091": {
      "label": "Amosclaud Model Service",
      "onAutoForward": "silent"
    },
    "9090": {
      "label": "Amosclaud Metrics and SSY",
      "onAutoForward": "silent"
    },
    "5432": {
      "label": "PostgreSQL",
      "onAutoForward": "silent"
    },
    "6379": {
      "label": "Redis",
      "onAutoForward": "silent"
    }
  },
  "remoteEnv": {
    "PYTHONPATH": "/workspaces/amosclaude-clean"
  },
  "postCreateCommand": "bash scripts/bootstrap-workspace.sh",
  "postStartCommand": "mkdir -p data/repositories data/model/checkpoints/versions data/model/logs/service data/model/training/jobs && (python -m amosclaud_platform status || true)",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-python.black-formatter",
        "ms-python.isort",
        "ms-azuretools.vscode-docker",
        "eamodio.gitlens",
        "redhat.vscode-yaml"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "python.testing.pytestEnabled": true,
        "python.testing.pytestArgs": ["tests"],
        "python.analysis.extraPaths": [
          "/workspaces/amosclaude-clean"
        ],
        "editor.formatOnSave": true,
        "files.exclude": {
          "**/__pycache__": true,
          "**/.pytest_cache": true,
          "data/model/checkpoints": true,
          "data/model/logs": true
        }
      }
    }
  },
  "remoteUser": "vscode"
}
