{
  "version": 1,
  "server_managed": true,
  "experimental_agent_teams": false,
  "network_domain_allowlist": [
    "api.github.com",
    "github.com",
    "objects.githubusercontent.com",
    "cdn.jsdelivr.net",
    "www.amosclaud.com"
  ],
  "default_sandbox_image": "amosclaud/workspace-base:latest",
    "www.amosclaud.com"
  ],
  "default_sandbox_image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "repository_sync": {
    "direction": "bidirectional",
    "github_to_platform": "signed-webhook-fast-forward-only",
    "platform_to_github": "authenticated-git-push",
    "overwrite_dirty_workspaces": false,
    "overwrite_diverged_history": false
  },
  "sandbox_resource_limits": {
    "max_cpu_cores": 2,
    "max_memory_mb": 4096,
    "max_processes": 512,
    "idle_timeout_seconds": 1800,
    "run_as_user": "developer",
    "default_network": "none",
    "allow_internal_mesh_access": false
  },
  "developer_overrides": {
    "allowed": false,
    "reason": "Organization policy is controlled by the Amosclaud server administrator."
  }
}
