# Amosclaud production configuration.
#
# Keep real secrets in Railway or another deployment secret manager. Never
# commit client secrets, API keys, SMTP passwords, or token-encryption keys.

COMPOSE_PROJECT_NAME=amosclaud

# Only www.amosclaud.com belongs to this deployment. The apex amosclaud.com
# hostname is a separate platform and must not receive Amosclaud cookies.
PRIMARY_DOMAIN=www.amosclaud.com
APEX_DOMAIN=
ACME_EMAIL=replace-with-your-operations-email@example.com

# Canonical application origin and host-only authentication cookies.
AMOSCLAUD_PUBLIC_URL=https://www.amosclaud.com
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_DOMAIN=
AUTH_SESSION_DAYS=7
LOG_LEVEL=INFO
WORKERS=1

# Persistent Railway storage. Mount one Railway Volume at /data. These paths
# keep users, password hashes, sessions, encrypted GitHub connections, imported
# repositories, and workspace state across deployments.
AUTH_DB_PATH=/data/auth.db
REPOSITORY_STORAGE_PATH=/data/repositories
MAX_REPOSITORIES_PER_USER=10
MAX_REPOSITORY_BYTES=524288000

# PostgreSQL identifiers are not secrets. The password belongs in Railway or a
# mounted secret file when PostgreSQL is enabled.
POSTGRES_DB=amosclaud_db
POSTGRES_USER=amosclaud

# Optional GitHub identity and repository integration. Email/password and email
# codes remain available even when GitHub is not configured.
GITHUB_CLIENT_ID=replace-with-github-client-id
# GITHUB_CLIENT_SECRET=<set in Railway>
GITHUB_CALLBACK_URL=https://www.amosclaud.com/auth/github/callback
GITHUB_REPOSITORY_CALLBACK_URL=https://www.amosclaud.com/api/v1/auth/github/admin-callback
GITHUB_ADMIN_CALLBACK_URL=https://www.amosclaud.com/api/v1/auth/github/admin-callback
GITHUB_ADMIN_SEND_REDIRECT_URI=true

# Encrypt stored developer GitHub authorizations. Use one stable random value
# and do not rotate it without requiring users to reconnect GitHub.
# GITHUB_TOKEN_ENCRYPTION_KEY=<set in Railway>

# GitHub App webhook integration for GitHub -> Amosclaud events. The primary
# value must exactly match the secret configured in the GitHub App settings.
# During rotation only, keep the former value in the PREVIOUS slot, update the
# GitHub App, verify a successful delivery, then remove the PREVIOUS variable.
# GITHUB_APP_WEBHOOK_SECRET=<set in Railway>
# GITHUB_APP_WEBHOOK_SECRET_PREVIOUS=<temporary rotation value only>

# Configured platform-owner recovery identity. Ordinary GitHub users do not
# receive administrator access.
AMOSCLAUD_ADMIN_GITHUB_IDS=271083488
AMOSCLAUD_ADMIN_GITHUB_LOGINS=wamakologeorge-dev
AMOSCLAUD_ADMIN_GITHUB_REPOSITORY=wamakologeorge-dev/amosclaude-clean
AMOSCLAUD_ADMIN_GITHUB_EMAIL=wamakologeorge@gmail.com

# Optional Google OAuth. The primary account portal remains email-first.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://www.amosclaud.com/api/v1/auth/google/callback

# Account security email. Railway commonly blocks or restricts SMTP, so HTTPS
# delivery through Resend is preferred. SMTP remains available as a fallback.
# RESEND_API_KEY=<set in Railway>
AMOSCLAUD_SECURITY_FROM=no-reply@amosclaud.com
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=587
MAIL_SMTP_USERNAME=
MAIL_SMTP_PASSWORD=
MAIL_SMTP_TLS=true
MAIL_SMTP_FROM=no-reply@amosclaud.com

# First-party model runtime.
AMOSCLAUD_MODEL_URL=http://host.docker.internal:11434
AMOSCLAUD_MODEL_COMPLETIONS_PATH=/v1/chat/completions
AMOSCLAUD_MODEL=qwen2.5-coder:1.5b
AMOSCLAUD_MODEL_PROBE_TIMEOUT=10
AMOSCLAUD_MODEL_TIMEOUT=300
AMOSCLAUD_MODEL_RETRIES=2
AMOSCLAUD_ALLOW_EXTERNAL_ADAPTERS=false

# Optional billing identifiers.
STRIPE_FULL_MONTHLY_PRICE_ID=
STRIPE_FULL_ANNUAL_PRICE_ID=
STRIPE_AGENT_STARTER_PRICE_ID=
STRIPE_AGENT_BUILDER_PRICE_ID=
STRIPE_AGENT_STUDIO_PRICE_ID=


# Verified one-time payment access. A successful $15 payment grants the Full
# Package for 30 days by default. Change these values before deployment if your
# published offer is different.
AMOSCLAUD_INSTANT_PRICE_CENTS=1500
AMOSCLAUD_INSTANT_ACCESS_DAYS=30
AMOSCLAUD_PAYMENT_ORDER_MINUTES=20

# Cash App Pay through Square. Keep tokens and signature keys only in Railway.
SQUARE_ENVIRONMENT=production
SQUARE_APPLICATION_ID=
SQUARE_LOCATION_ID=
SQUARE_MERCHANT_ID=
SQUARE_API_VERSION=2026-05-20
# SQUARE_ACCESS_TOKEN=<set in Railway>
# SQUARE_WEBHOOK_SIGNATURE_KEY=<set in Railway>
SQUARE_WEBHOOK_NOTIFICATION_URL=https://www.amosclaud.com/api/v1/billing/webhooks/square

# Bitcoin through a merchant-controlled BTCPay Server store. Use an API key
# restricted to viewing and creating invoices for this store.
BTCPAY_SERVER_URL=
BTCPAY_STORE_ID=
# BTCPAY_API_KEY=<set in Railway>
# BTCPAY_WEBHOOK_SECRET=<set in Railway>
