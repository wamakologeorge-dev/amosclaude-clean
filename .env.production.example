# Amosclaud production Docker Compose configuration.
#
# Copy this file to .env.production. Keep real secrets out of this file; they
# belong in the ignored ./secrets directory described in secrets/README.md.
# Start the stack with:
#   docker compose --env-file .env.production up -d --build

COMPOSE_PROJECT_NAME=amosclaud

# Public DNS and automatic TLS. Only www.amosclaud.com belongs to this
# Amosclaud deployment. The apex amosclaud.com hostname is hosted by a separate
# platform and must not be routed to this application.
PRIMARY_DOMAIN=www.amosclaud.com
APEX_DOMAIN=
ACME_EMAIL=replace-with-your-operations-email@example.com

# Application runtime. Authentication cookies are intentionally host-only so
# the separate amosclaud.com platform cannot receive Amosclaud sessions.
AMOSCLAUD_PUBLIC_URL=https://www.amosclaud.com
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_DOMAIN=
LOG_LEVEL=INFO
WORKERS=1
AUTH_SESSION_DAYS=7
MAX_REPOSITORIES_PER_USER=10
MAX_REPOSITORY_BYTES=524288000

# PostgreSQL identifiers are not secrets. The password is loaded from
# secrets/postgres_password.
POSTGRES_DB=amosclaud_db
POSTGRES_USER=amosclaud

# GitHub is the only public Amosclaud account provider. Any GitHub user may
# authorize this application; the callback creates a first-time account or
# signs in the existing account. Supply GITHUB_CLIENT_SECRET through Railway or
# the deployment secret manager; never place it in this example file.
GITHUB_CLIENT_ID=replace-with-github-oauth-client-id
GITHUB_CALLBACK_URL=https://www.amosclaud.com/auth/github/callback
# GITHUB_CLIENT_SECRET=<set in Railway or the deployment secret manager>

# Optional separate GitHub owner-recovery OAuth application. This route grants
# administrator access only to the exact configured GitHub ID and login. It is
# not used for ordinary customer signup.
GITHUB_ADMIN_CALLBACK_URL=https://www.amosclaud.com/api/v1/auth/github/admin-callback
GITHUB_REPOSITORY_CALLBACK_URL=https://www.amosclaud.com/api/v1/auth/github/admin-callback
GITHUB_ADMIN_SEND_REDIRECT_URI=true
AMOSCLAUD_ADMIN_GITHUB_IDS=271083488
AMOSCLAUD_ADMIN_GITHUB_LOGINS=wamakologeorge-dev
AMOSCLAUD_ADMIN_GITHUB_REPOSITORY=wamakologeorge-dev/amosclaude-clean
AMOSCLAUD_ADMIN_GITHUB_EMAIL=wamakologeorge@gmail.com

# Google credentials may still be used by non-authentication integrations, but
# the production account gateway does not expose Google, email, or password
# login. Keep these empty unless a separate integration requires them.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# First-party Amosclaud model runtime. For an Ollama process running directly on
# the Docker host, host.docker.internal is mapped by docker-compose.yml. Change
# this URL when the inference service has another internal DNS name.
AMOSCLAUD_MODEL_URL=http://host.docker.internal:11434
AMOSCLAUD_MODEL_COMPLETIONS_PATH=/v1/chat/completions
AMOSCLAUD_MODEL=qwen2.5-coder:1.5b
AMOSCLAUD_MODEL_PROBE_TIMEOUT=10
AMOSCLAUD_MODEL_TIMEOUT=300
AMOSCLAUD_MODEL_RETRIES=2
AMOSCLAUD_ALLOW_EXTERNAL_ADAPTERS=false

# Optional Stripe price identifiers. Stripe API and webhook secrets are loaded
# from files in ./secrets and may remain empty while billing is disabled.
STRIPE_FULL_MONTHLY_PRICE_ID=
STRIPE_FULL_ANNUAL_PRICE_ID=
STRIPE_AGENT_STARTER_PRICE_ID=
STRIPE_AGENT_BUILDER_PRICE_ID=
STRIPE_AGENT_STUDIO_PRICE_ID=
