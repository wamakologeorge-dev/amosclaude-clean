{
  "schema": "amosclaud.repository-control/v1",
  "priority": 0,
  "entrypoint": "amoscloud_ai.repository_control:initialize_repository_control",
  "load_before": [
    "repository .env",
    "application settings",
    "database initialization",
    "API router registration"
  ],
  "environment_files": [
    "autonomous.env",
    "runtime.env",
    ".env"
  ],
  "manifests": [
    "platform-requirements.json",
    "repair-policy.json"
  ],
  "automatic_scripts": [],
  "safety": {
    "execute_mutating_scripts_on_server_start": false,
    "allow_force_push_on_server_start": false,
    "preserve_process_environment_priority": true
  }
}
