{
  "schema": "amosclaud.pr-ci-repair/v1",
  "enabled": true,
  "same_repository_pull_requests_only": true,
  "max_repair_commits_per_pull_request": 3,
  "max_changed_files": 12,
  "max_patch_bytes": 250000,
  "source_providers": {
    "github_actions": true,
    "circleci_commit_status": true,
    "circleci_detailed_logs_require_secret": "CIRCLECI_TOKEN"
  },
  "protected_prefixes": [
    ".git/",
    ".amosclaud/",
    ".github/workflows/",
    ".github/actions/",
    ".github/scripts/",
    ".github/amosclaud-fixer/"
  ],
  "protected_paths": [
    "AGENTS.md",
    "docs/PYTHON_AUTONOMOUS_ENGINEERING_BOOK.md",
    "SECURITY.md",
    "CODEOWNERS",
    "Dockerfile",
    "railway.json",
    "vercel.json"
  ],
  "protected_names": [
    ".env",
    "secrets.json",
    "credentials.json"
  ],
  "verification": [
    "editable install in a fresh virtual environment",
    "flake8 critical-error scan",
    "python compileall",
    "pytest"
  ],
  "publishing": {
    "push_to_original_pull_request_branch": true,
    "direct_default_branch_writes": false,
    "force_push": false,
    "required_secret": "AMOSCLAUD_AUTONOMOUS_TOKEN"
  }
}
