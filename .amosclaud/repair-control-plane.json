{
  "schema": "amosclaud.repair-control-plane/v1",
  "enabled": true,
  "max_attempts_per_incident": 3,
  "incident_title_prefix": "Amosclaud Repair Incident",
  "repair_commit_marker": "incident:",
  "routes": {
    "default_branch": "review_branch",
    "same_repository_pull_request": "original_pull_request_branch",
    "protected_repair_engine": "maintenance_pull_request",
    "fork_pull_request": "report_only"
  },
  "providers": {
    "github_actions": {
      "enabled": true,
      "collect_failed_job_logs": true,
      "collect_annotations": true,
      "collect_artifact_metadata": true
    },
    "circleci": {
      "enabled": true,
      "token_secret": "CIRCLECI_TOKEN",
      "collect_step_output": true,
      "rerun_failed_workflow_when_reproduction_is_healthy": true
    }
  },
  "credentials": {
    "model_secret": "AMOSCLAUD_API_KEY",
    "pull_request_publish_secret": "AMOSCLAUD_AUTONOMOUS_TOKEN",
    "verification_must_be_credential_free": true
  },
  "regular_patch": {
    "max_changed_files": 12,
    "max_patch_bytes": 250000,
    "protected_prefixes": [
      ".git/",
      ".github/",
      ".amosclaud/",
      "Infrastructure/",
      "infrastructure/"
    ],
    "protected_paths": [
      "AGENTS.md",
      "SECURITY.md",
      "CODEOWNERS",
      "Dockerfile",
      "railway.json",
      "vercel.json"
    ],
    "protected_names": [
      ".env",
      "secrets.json",
      "credentials.json"
    ]
  },
  "maintenance_patch": {
    "max_changed_files": 8,
    "max_patch_bytes": 180000,
    "allowed_prefixes": [
      ".github/workflows/amosclaud-",
      ".github/scripts/amosclaud_",
      ".amosclaud/repair-control-plane.json",
      "tests/test_amosclaud_repair_",
      "tests/test_amosclaud_fixer_",
      "tests/test_pr_ci_repair_"
    ],
    "requires_test_change": true,
    "human_approval_required": true
  },
  "verification": {
    "base": [
      "editable_install",
      "flake8_critical",
      "python_compileall",
      "pytest_full"
    ],
    "adapters": {
      "javascript": "node_check_changed_javascript",
      "github_pages": "pytest_pages_contracts",
      "workflow": "pytest_workflow_contracts",
      "api_or_live_server": "pytest_api_smoke_contracts",
      "docker": "docker_build"
    }
  },
  "publishing": {
    "direct_default_branch_writes": false,
    "force_push": false,
    "same_repository_pull_requests_only": true,
    "maintenance_always_uses_new_pull_request": true
  }
}
