{
  "schema": "amosclaud.repair-control-plane/v2",
  "enabled": true,
  "max_attempts_per_incident": 3,
  "incident_title_prefix": "Amosclaud Repair Incident",
  "repair_commit_marker": "incident:",
  "routes": {
    "default_branch": "review_branch",
    "same_repository_pull_request": "original_pull_request_branch",
    "protected_repair_engine": "verified_repair_branch",
    "fork_pull_request": "verified_base_repository_branch"
  },
  "providers": {
    "github_actions": {
      "enabled": true,
      "collect_failed_job_logs": true,
      "collect_annotations": true,
      "collect_artifact_metadata": true
    },
    "circleci": {
      "enabled": true,
      "token_secret": "CIRCLECI_TOKEN",
      "collect_step_output": true,
      "rerun_failed_workflow_when_reproduction_is_healthy": true
    }
  },
  "credentials": {
    "model_secret": "AMOSCLAUD_API_KEY",
    "pull_request_publish_secret": "AMOSCLAUD_AUTONOMOUS_TOKEN",
    "verification_must_be_credential_free": true
  },
  "approval": {
    "required_only_for": [
      "environment_or_secret_content",
      "personal_information_content"
    ],
    "ordinary_code": false,
    "workflows": false,
    "infrastructure": false,
    "fork_origin": false
  },
  "regular_patch": {
    "max_changed_files": 25,
    "max_patch_bytes": 350000,
    "protected_prefixes": [
      ".git/"
    ],
    "protected_paths": [],
    "protected_names": [
      ".env",
      "secrets.json",
      "credentials.json",
      "personal-information.json",
      "personal_information.json",
      "pii.json",
      "pii.csv"
    ]
  },
  "maintenance_patch": {
    "max_changed_files": 16,
    "max_patch_bytes": 250000,
    "allowed_prefixes": [
      ".github/",
      ".amosclaud/",
      "amosclaud_bot/",
      "tests/"
    ],
    "requires_test_change": true,
    "human_approval_required": false
  },
  "verification": {
    "base": [
      "editable_install",
      "flake8_critical",
      "python_compileall",
      "pytest_full"
    ],
    "adapters": {
      "javascript": "node_check_changed_javascript",
      "github_pages": "pytest_pages_contracts",
      "workflow": "pytest_workflow_contracts",
      "api_or_live_server": "pytest_api_smoke_contracts",
      "docker": "docker_build"
    }
  },
  "publishing": {
    "direct_default_branch_writes": false,
    "force_push": false,
    "same_repository_pull_requests_only": false,
    "fork_pull_request_strategy": "verified_base_repository_branch",
    "maintenance_always_uses_new_pull_request": true
  }
}
