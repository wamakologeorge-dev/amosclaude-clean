# Amosclaud telemetry is opt-in so existing and legacy services keep working.
AMOSCLAUD_TELEMETRY_ENABLED=false
AMOSCLAUD_TELEMETRY_ENVIRONMENT=local
AMOSCLAUD_TELEMETRY_TTL=168h
AMOSCLAUD_PROMETHEUS_RETENTION=15d

# Application -> OpenTelemetry Collector.
OTEL_SERVICE_NAME=amosclaud-platform
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp
OTEL_PROPAGATORS=tracecontext,baggage
OTEL_PYTHON_LOG_AUTO_INSTRUMENTATION=true
# Keep high-volume health endpoints out of traces when desired.
OTEL_PYTHON_FASTAPI_EXCLUDED_URLS=health,healthz,readyz

# Private ClickHouse telemetry backend. Never commit the real password.
CLICKHOUSE_DATABASE=amosclaud_telemetry
CLICKHOUSE_USER=otel
CLICKHOUSE_PASSWORD=
