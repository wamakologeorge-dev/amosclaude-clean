# Amosclaud isolated workspace runtime
# Generate a unique random value; never commit the real token.
AMOSCLAUD_WORKSPACE_RUNTIME_TOKEN=

# Persistent repository storage mounted on the execution host.
AMOSCLAUD_REPOSITORY_STORAGE_ROOT=/var/lib/amosclaud/repositories
AMOSCLAUD_WORKSPACE_IMAGE=amosclaud/workspace-base:latest

# Browser origins allowed to open signed terminal WebSockets.
AMOSCLAUD_WORKSPACE_ALLOWED_ORIGINS=https://amosclaud.com,https://www.amosclaud.com

# Secure defaults. `none` blocks all container networking.
AMOSCLAUD_WORKSPACE_NETWORK=none
AMOSCLAUD_WORKSPACE_CPU=2
AMOSCLAUD_WORKSPACE_MEMORY_MB=4096
AMOSCLAUD_WORKSPACE_PIDS=512
AMOSCLAUD_WORKSPACE_IDLE_TIMEOUT_SECONDS=1800
AMOSCLAUD_WORKSPACE_UID=1000
AMOSCLAUD_WORKSPACE_GID=1000

# Persistent repository deletion remains an explicit, separate owner decision.
AMOSCLAUD_WORKSPACE_DELETE_STORAGE=false
