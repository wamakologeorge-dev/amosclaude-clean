#!/usr/bin/env bash
set -euo pipefail

command_name="${1:-help}"
shift || true
workspace_root="${AMOSCLAUD_WORKSPACE_ROOT:-/workspace}"

usage() {
  cat <<'EOF'
Amosclaud terminal tools

  amos status               Show branch and changed files
  amos files [depth]        List repository files
  amos edit <path>          Open or create a file in nano
  amos vim <path>           Open or create a file in vim
  amos changed              Review changed files and diff
  amos test                 Detect and run the project tests
  amos build                Detect and run the project build
  amos lint                 Detect and run the project linter
  amos run                  Detect and run the development app
  amos debug                Start a detected project in debugger mode
  amos ports                Show local listening ports
  amos problems             Run safe repository problem checks
  amos connectors           Show repository connectors without credentials
  amos network              Diagnose interfaces, routes, DNS, and HTTPS
  amos commit [message]     Commit current repository changes
  amos help                 Show this help

GitHub pull, push, and Sync & Push are available from the browser Project tools.
Credentials remain in the Amosclaud control plane and are never placed in the
terminal process.
EOF
}

inside_workspace() {
  local root current
  root="$(readlink -f -- "$workspace_root")"
  current="$(pwd -P)"
  case "$current" in
    "$root"|"$root"/*) ;;
    *) echo "Run Amosclaud tools inside $root." >&2; exit 2 ;;
  esac
}

has_npm_script() {
  local script_name="$1"
  [[ -f package.json ]] && command -v npm >/dev/null 2>&1 \
    && node -e "const p=require('./package.json'); process.exit(p.scripts&&p.scripts['$script_name']?0:1)" 2>/dev/null
}

project_script() {
  local action="$1"
  if has_npm_script "$action"; then
    printf 'npm run %s\n' "$action"
    return 0
  fi
  if [[ -f Makefile || -f makefile ]]; then
    if make -qp 2>/dev/null | grep -Eq "^${action}:([^=]|$)"; then
      printf 'make %s\n' "$action"
      return 0
    fi
  fi
  case "$action" in
    test)
      if [[ -d tests || -f pytest.ini ]] && command -v python3 >/dev/null 2>&1; then printf 'python3 -m pytest -q\n'; return 0; fi
      if [[ -f Cargo.toml ]] && command -v cargo >/dev/null 2>&1; then printf 'cargo test\n'; return 0; fi
      if [[ -f go.mod ]] && command -v go >/dev/null 2>&1; then printf 'go test ./...\n'; return 0; fi
      ;;
    build)
      if [[ -f Cargo.toml ]] && command -v cargo >/dev/null 2>&1; then printf 'cargo build\n'; return 0; fi
      if [[ -f go.mod ]] && command -v go >/dev/null 2>&1; then printf 'go build ./...\n'; return 0; fi
      ;;
    lint)
      if [[ -f pyproject.toml ]] && grep -q '\[tool.ruff' pyproject.toml && python3 -c 'import ruff' >/dev/null 2>&1; then printf 'python3 -m ruff check .\n'; return 0; fi
      ;;
    run)
      if has_npm_script dev; then printf 'npm run dev\n'; return 0; fi
      if has_npm_script start; then printf 'npm run start\n'; return 0; fi
      if [[ -f Makefile || -f makefile ]]; then
        if make -qp 2>/dev/null | grep -Eq '^dev:([^=]|$)'; then printf 'make dev\n'; return 0; fi
        if make -qp 2>/dev/null | grep -Eq '^run:([^=]|$)'; then printf 'make run\n'; return 0; fi
      fi
      if [[ -f manage.py ]]; then printf 'python3 manage.py runserver 0.0.0.0:8000\n'; return 0; fi
      if [[ -f main.py ]]; then printf 'python3 main.py\n'; return 0; fi
      if [[ -f app.py ]]; then printf 'python3 app.py\n'; return 0; fi
      if [[ -f go.mod ]] && command -v go >/dev/null 2>&1; then printf 'go run .\n'; return 0; fi
      if [[ -f Cargo.toml ]] && command -v cargo >/dev/null 2>&1; then printf 'cargo run\n'; return 0; fi
      ;;
  esac
  return 1
}

debug_script() {
  if has_npm_script dev; then
    printf 'NODE_OPTIONS=--inspect=127.0.0.1:9229 npm run dev\n'
    return 0
  fi
  if has_npm_script start; then
    printf 'NODE_OPTIONS=--inspect=127.0.0.1:9229 npm run start\n'
    return 0
  fi
  if [[ -f manage.py ]]; then
    printf 'python3 -m pdb manage.py runserver 0.0.0.0:8000\n'
    return 0
  fi
  if [[ -f main.py ]]; then
    printf 'python3 -m pdb main.py\n'
    return 0
  fi
  if [[ -f app.py ]]; then
    printf 'python3 -m pdb app.py\n'
    return 0
  fi
  if [[ -f Makefile || -f makefile ]]; then
    if make -qp 2>/dev/null | grep -Eq '^debug:([^=]|$)'; then
      printf 'make debug\n'
      return 0
    fi
  fi
  return 1
}

inside_workspace

case "$command_name" in
  help|-h|--help)
    usage
    ;;
  status)
    git status --short --branch
    ;;
  files)
    depth="${1:-4}"
    [[ "$depth" =~ ^[1-9][0-9]?$ ]] || { echo "Depth must be 1-99." >&2; exit 2; }
    find . -maxdepth "$depth" -path './.git' -prune -o -type f -print \
      | sed 's#^./##' | sort | head -500
    ;;
  edit|vim)
    path="${1:-}"
    [[ -n "$path" ]] || { echo "Usage: amos $command_name <path>" >&2; exit 2; }
    [[ "$path" != /* && "$path" != *"../"* && "$path" != ".." ]] \
      || { echo "The file must stay inside $workspace_root." >&2; exit 2; }
    mkdir -p -- "$(dirname -- "$path")"
    if [[ "$command_name" == "vim" ]]; then exec vim -- "$path"; else exec nano -- "$path"; fi
    ;;
  changed)
    git status --short --branch
    printf '\n'
    git diff --stat
    git diff
    ;;
  test|build|lint|run)
    if detected="$(project_script "$command_name")"; then
      echo "[Amosclaud] Starting $command_name: $detected"
      exec bash -lc "$detected"
    fi
    echo "No standard $command_name command was detected. Use the browser Project tools or run the project command directly." >&2
    exit 3
    ;;
  debug)
    if detected="$(debug_script)"; then
      echo "[Amosclaud Debug] Starting: $detected"
      echo "[Amosclaud Debug] Live debugger input and output will remain in this terminal."
      exec bash -lc "$detected"
    fi
    echo "No standard debug entry point was detected. Run the debugger directly, for example: python3 -m pdb <file.py>, node --inspect-brk <file.js>, or gdb <binary>." >&2
    exit 3
    ;;
  ports)
    printf '=== Amosclaud local listening ports ===\n'
    ss -ltnp 2>/dev/null \
      || netstat -ltnp 2>/dev/null \
      || lsof -nP -iTCP -sTCP:LISTEN 2>/dev/null \
      || true
    printf '\nPorts remain local to the workspace unless platform forwarding is enabled.\n'
    ;;
  problems)
    printf '=== Amosclaud repository problems ===\n'
    problem=0
    git diff --check || problem=1
    for action in lint test; do
      if detected="$(project_script "$action")"; then
        echo "+ $detected"
        bash -lc "$detected" || problem=1
      fi
    done
    if [[ "$problem" -eq 0 ]]; then
      echo "No problem was detected by the available checks."
    else
      echo "One or more checks failed. Open Amosclaud Doctor in the terminal agent hub for diagnosis." >&2
      exit 1
    fi
    ;;
  connectors)
    printf '=== Amosclaud connectors ===\n'
    git remote -v 2>/dev/null || true
    printf '\nGitHub credentials: control-plane only (not present in this terminal)\n'
    printf 'Agent connector: Amosclaud terminal agent hub\n'
    printf 'Repository connector: persistent repository storage\n'
    printf 'Terminal provider: %s\n' "${AMOSCLAUD_TERMINAL_PROVIDER:-isolated}"
    ;;
  network)
    printf '=== Amosclaud network diagnostics ===\n'
    printf 'Interfaces:\n'
    ip -brief address 2>/dev/null || true
    printf '\nRoutes:\n'
    ip route 2>/dev/null || true
    printf '\nDNS lookup:\n'
    getent hosts github.com 2>/dev/null || true
    printf '\nOutbound HTTPS:\n'
    curl -I --max-time 5 https://github.com 2>/dev/null | head -8 || true
    printf '\nNetwork access follows the server-managed workspace policy.\n'
    ;;
  commit)
    message="${*:-Update from Amosclaud terminal}"
    git add -A
    if git diff --cached --quiet; then
      echo "No changes to commit."
      exit 0
    fi
    git commit -m "$message"
    ;;
  *)
    echo "Unknown Amosclaud tool: $command_name" >&2
    usage >&2
    exit 2
    ;;
esac
