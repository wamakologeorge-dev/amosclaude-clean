AMOSCLAUD_CONTROL_PLANE_HOST=0.0.0.0
AMOSCLAUD_CONTROL_PLANE_PORT=8300
AMOSCLAUD_CONTROL_PLANE_TOKEN=replace-with-a-long-random-private-service-token
AMOSCLAUD_REDIS_URL=redis://redis:6379/0
AMOSCLAUD_TASK_QUEUE=amosclaud-agent-tasks
AMOSCLAUD_WORKER_CONCURRENCY=4

# Local execution is intentionally opt-in. The worker must run as an unprivileged
# user and receive only the repository storage mount, never platform secrets.
AMOSCLAUD_EXECUTION_MODE=local
AMOSCLAUD_REPOSITORY_STORAGE_ROOT=/var/lib/amosclaud/repositories
AMOSCLAUD_ALLOWED_COMMANDS=git,npm,npx,pnpm,yarn,node,python,python3,pytest,uv,ruff,mypy,make,go,cargo
AMOSCLAUD_MAX_COMMAND_TIMEOUT_MS=900000

# Optional lifecycle bridge to the existing isolated Python/Docker runtime.
AMOSCLAUD_WORKSPACE_RUNTIME_URL=http://workspace-runtime:8200
AMOSCLAUD_WORKSPACE_RUNTIME_TOKEN=replace-with-the-workspace-runtime-token

# File watchers require the same repository storage mount as the worker.
AMOSCLAUD_WATCHERS_ENABLED=true
AMOSCLAUD_WATCHER_RECONCILE_MS=10000

# Comma-separated npm packages containing an `amosclaud.skills` manifest.
AMOSCLAUD_SKILL_PACKAGES=
AMOSCLAUD_SKILL_OUTPUT_ROOT=/var/lib/amosclaud/skills
