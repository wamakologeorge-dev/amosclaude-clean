{
  "name": "@amosclaud/control-plane",
  "version": "0.1.0",
  "description": "Private Node.js orchestration plane for Amosclaud autonomous workspaces",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "start": "node src/server.mjs",
    "worker": "node src/worker.mjs",
    "skills:sync": "node src/skills-sync.mjs",
    "supply-chain:check": "node scripts/supply-chain-check.mjs",
    "test": "node --test",
    "check": "npm run supply-chain:check && node --check src/*.mjs scripts/*.mjs test/*.mjs && node --test"
  },
  "dependencies": {
    "bullmq": "5.79.3",
    "chokidar": "5.0.0",
    "execa": "10.0.0",
    "fastify": "5.10.0",
    "ioredis": "5.11.1",
    "zod": "4.4.3"
  }
}
