# Amosclaud — Railway environment template
#
# Copy these lines into Railway's Variables > Raw Editor.
# Never commit real passwords, tokens, API keys, or webhook secrets.

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_NAME=Amosclaud AI
APP_VERSION=1.0.0
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO
HOST=0.0.0.0
# Railway normally provides PORT automatically. Keep this only for local use.
PORT=8000
WORKERS=1
ALLOWED_HOSTS=https://www.amosclaud.com,https://vscode.dev,https://insiders.vscode.dev,https://github.dev

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
# Use independent random values with at least 32 characters.
SECRET_KEY=
AUTH_COOKIE_SECURE=true
# Protected key used by Autonomous API clients and the internal MCP-to-API call.
AMOSCLAUD_AUTONOMOUS_KEY=
# Optional separate bearer key for clients connecting to the remote /mcp endpoint.
# When blank, /mcp accepts AMOSCLAUD_AUTONOMOUS_KEY.
AMOSCLAUD_MCP_ACCESS_KEY=
AMOSCLAUD_MCP_TIMEOUT=60
# Fernet key used only for encrypted workflow-dashboard variables.
AMOSCLAUD_DASHBOARD_KEY=
# Optional one-time migration target for legacy dashboard rows. Remove after use.
AMOSCLAUD_LEGACY_OWNER_USER_ID=
# Signs short-lived internal Amosclaud Byte commands. Do not expose this value
# to browsers, repository files, user jobs, or public API responses.
AMOSCLAUD_BYTE_BUS_SECRET=

# -----------------------------------------------------------------------------
# Database and persistent storage
# -----------------------------------------------------------------------------
# For Railway PostgreSQL, use the database URL supplied by the PostgreSQL
# service. AMOSCLAUD_PLATFORM_DATABASE_URL is shared by the API gateway,
# Autonomous Agent, root orchestrator, repository service, and CI workers.
DATABASE_URL=sqlite:///./data/amosclaud.db
AMOSCLAUD_PLATFORM_DATABASE_URL=sqlite:///./data/amosclaud-platform.db
AUTH_DB_PATH=./data/auth.db
REPOSITORY_STORAGE_PATH=./data/repositories
STORAGE_PATH=./data/storage
AMOSCLAUD_DASHBOARD_DATA=./data/dashboard

# -----------------------------------------------------------------------------
# Monitoring and audit evidence
# -----------------------------------------------------------------------------
AMOSCLAUD_MONITORING_DB_PATH=./data/monitoring.db
# Use a separate random value for trusted CI/deployment metric and audit ingestion.
AMOSCLAUD_MONITORING_INGEST_TOKEN=
# Optional health endpoint for the standalone metrics service.
AMOSCLAUD_METRICS_HEALTH_URL=http://metrics:9090/health

# -----------------------------------------------------------------------------
# CDN edge cache
# -----------------------------------------------------------------------------
# Fixed origin only. Clients can never supply or override this URL.
AMOSCLAUD_CDN_ORIGIN_URL=http://preview-service:8080
# auto uses Redis when REDIS_URL exists and otherwise uses bounded local memory.
AMOSCLAUD_CDN_CACHE_BACKEND=auto
# Use a separate random value for deployment-pipeline cache purges.
AMOSCLAUD_CDN_PURGE_TOKEN=
AMOSCLAUD_CDN_DEFAULT_TTL_SECONDS=300
AMOSCLAUD_CDN_MAX_TTL_SECONDS=86400
AMOSCLAUD_CDN_ORIGIN_TIMEOUT_SECONDS=10
AMOSCLAUD_CDN_MAX_ASSET_BYTES=26214400
AMOSCLAUD_CDN_MEMORY_MAX_ENTRIES=2000
AMOSCLAUD_CDN_MEMORY_MAX_BYTES=134217728

# -----------------------------------------------------------------------------
# Redis and background workers
# -----------------------------------------------------------------------------
# When Railway Redis is attached, set REDIS_URL from that service.
REDIS_URL=redis://localhost:6379/0
# Leave these blank to reuse REDIS_URL automatically.
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# -----------------------------------------------------------------------------
# Isolated runner station
# -----------------------------------------------------------------------------
# This image must already exist on the worker station. User workloads run with
# no network, a read-only root filesystem, dropped capabilities, and strict
# resource limits. Never mount the Docker socket inside the workload container.
AMOSCLAUD_RUNNER_IMAGE=amosclaud/runner-python-node:1
AMOSCLAUD_RUNNER_ALLOWLIST=python,python3,pip,pip3,pytest,node,npm,npx,pnpm,yarn,make
AMOSCLAUD_RUNNER_CPUS=1.0
AMOSCLAUD_RUNNER_MEMORY=768m
AMOSCLAUD_RUNNER_PIDS_LIMIT=128
AMOSCLAUD_RUNNER_TIMEOUT_SECONDS=600
AMOSCLAUD_RUNNER_USER=65532:65532

# -----------------------------------------------------------------------------
# Dedicated static preview service
# -----------------------------------------------------------------------------
# Use a distinct random service key shared only by the worker and preview service.
AMOSCLAUD_PREVIEW_SERVICE_KEY=
AMOSCLAUD_PREVIEW_SERVICE_URL=http://preview-service:8080
AMOSCLAUD_PREVIEW_DATA=/data/previews
AMOSCLAUD_PREVIEW_MAX_ARCHIVE_BYTES=52428800
AMOSCLAUD_PREVIEW_MAX_FILES=2000
PREVIEW_WORKERS=1

# -----------------------------------------------------------------------------
# Amosclaud public service
# -----------------------------------------------------------------------------
# Public Amosclaud traffic must use HTTPS so POST requests are never rewritten
# during an HTTP-to-HTTPS redirect.
AMOSCLAUD_PUBLIC_URL=https://www.amosclaud.com
AMOSCLAUD_API_URL=https://www.amosclaud.com
AMOSCLAUD_PROVIDER_API_URL=https://www.amosclaud.com
AMOSCLAUD_API_COMPLETIONS_PATH=/api/v1/provider/chat/completions
AMOSCLAUD_API_KEY=
AMOSCLAUD_API_MODEL=amosclaud-agent
AMOSCLAUD_AGENT_CREDITS_PER_REQUEST=1

# -----------------------------------------------------------------------------
# Amosclaud model runtime
# -----------------------------------------------------------------------------
# Use one model URL only. Point this to the deployed model service when present.
AMOSCLAUD_MODEL_URL=http://127.0.0.1:8091
AMOSCLAUD_MODEL=amosclaud-folder-v1
AMOSCLAUD_MODEL_TOKEN=
AMOSCLAUD_MODEL_TIMEOUT=120
AMOSCLAUD_MODEL_HOME=/data/amosclaud-model

# -----------------------------------------------------------------------------
# Optional external model provider
# -----------------------------------------------------------------------------
# Leave blank when Amosclaud's own model runtime is used.
OPENAI_API_KEY=
EXTERNAL_API_KEY=

# -----------------------------------------------------------------------------
# Optional supporting service
# -----------------------------------------------------------------------------
AUTH_SERVICE_URL=http://localhost:8001

# -----------------------------------------------------------------------------
# Billing — only required when Stripe billing is enabled
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_FULL_MONTHLY_PRICE_ID=
STRIPE_FULL_ANNUAL_PRICE_ID=

# Prepaid agent credits. For each pack, configure either a Stripe one-time Price
# ID or an inline amount in the smallest currency unit (for USD, cents).
STRIPE_AGENT_CURRENCY=usd
STRIPE_AGENT_STARTER_PRICE_ID=
STRIPE_AGENT_STARTER_AMOUNT_CENTS=
STRIPE_AGENT_BUILDER_PRICE_ID=
STRIPE_AGENT_BUILDER_AMOUNT_CENTS=
STRIPE_AGENT_STUDIO_PRICE_ID=
STRIPE_AGENT_STUDIO_AMOUNT_CENTS=

# -----------------------------------------------------------------------------
# Railway-provided variables
# -----------------------------------------------------------------------------
# Do not manually create or delete these. Railway injects them automatically:
# RAILWAY_PROJECT_ID
# RAILWAY_SERVICE_ID
# RAILWAY_ENVIRONMENT_ID
# RAILWAY_ENVIRONMENT
# RAILWAY_PUBLIC_DOMAIN
