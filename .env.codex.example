# Copy to a private runtime environment. Never commit the real key.
OPENAI_API_KEY=
AMOSCLAUD_CODEX_MODEL=
AMOSCLAUD_CODEX_CONFIG=config/autonomous-codex.toml
AMOSCLAUD_WORKSPACE=workspace/projects

# Optional Codex Cloud provider. External providers are never selected unless
# this is explicitly enabled; Amosclaud's own runtime remains preferred.
AMOSCLAUD_ALLOW_EXTERNAL_ADAPTERS=false
OPENAI_MODEL=

# Optional Railway public health evidence exposed on /ready (not /health).
AMOSCLAUD_RAILWAY_HEALTHCHECK_ENABLED=false
RAILWAY_PUBLIC_DOMAIN=
AMOSCLAUD_RAILWAY_HEALTH_PATH=/health
AMOSCLAUD_RAILWAY_HEALTH_TIMEOUT=5
